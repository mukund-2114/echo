# Echo - Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ============================================
# AI Services
# ============================================

# Google Gemini API
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API (Alternative/Backup)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ============================================
# Finance APIs
# ============================================

# Alpha Vantage (Stock Market Data)
# Get your key from: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# CoinGecko (Cryptocurrency Data)
# Free tier doesn't require API key
# Pro tier: https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=optional_coingecko_pro_key

# ============================================
# Cloud Services (Optional)
# ============================================

# Supabase (Cloud Sync & Backup)
# Create project at: https://supabase.com
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Firebase (Push Notifications)
# Create project at: https://console.firebase.google.com
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_PROJECT_ID=your_firebase_project_id_here

# ============================================
# Security
# ============================================

# Database Encryption Key
# Generate a secure random key (256-bit recommended)
# You can generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DB_ENCRYPTION_KEY=generate_secure_random_key_here

# ============================================
# App Configuration
# ============================================

# Environment
APP_ENV=development

# API Timeout (milliseconds)
API_TIMEOUT=10000

# Enable Analytics (true/false)
ENABLE_ANALYTICS=false

# Enable Crash Reporting (true/false)
ENABLE_CRASH_REPORTING=true

# ============================================
# Development Settings
# ============================================

# Debug Mode
DEBUG=true

# Log Level (error, warn, info, debug)
LOG_LEVEL=debug

# Mock API Responses (for testing without API keys)
MOCK_API_RESPONSES=false
